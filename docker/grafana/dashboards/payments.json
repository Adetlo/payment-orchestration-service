        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(payment_received_total[1m]))",
          "legendFormat": "created",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(payment_completed_total[1m]))",
          "legendFormat": "completed",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
