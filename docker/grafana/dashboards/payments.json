            "uid": "prometheus"
          },
          "expr": "sum(rate(payment_failed_total[1m]))",
          "legendFormat": "failed",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
